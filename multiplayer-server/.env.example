# Environment variables must be set by the shell / deployment service.
HOST=127.0.0.1
PORT=8788
DB_PATH=data/hitme.sqlite
ALLOWED_ORIGINS=http://127.0.0.1:8791,http://localhost:8791
# Required outside local development. Use a valid publicly trusted certificate.
# NODE_ENV=production
# TLS_CERT=/secure/fullchain.pem
# TLS_KEY=/secure/privkey.pem
# Supabase adapter is not active. Never copy service-role credentials to Unity.

# Existing incomplete-input proposal, labelled in snapshots; false blocks incomplete timeout.
PROPOSED_TIMEOUT=true
