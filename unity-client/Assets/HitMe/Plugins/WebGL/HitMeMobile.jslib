mergeInto(LibraryManager.library,{HitMeCopyText:function(ptr){var text=UTF8ToString(ptr);if(navigator.clipboard)navigator.clipboard.writeText(text).catch(function(){console.warn("Clipboard unavailable; use the displayed room code.");});else console.warn("Clipboard unavailable; use the displayed room code.");},HitMeShareInvite:function(ptr){var url=UTF8ToString(ptr);var copy=function(){if(navigator.clipboard)navigator.clipboard.writeText(url).catch(function(){});};if(navigator.share)navigator.share({title:"HIT ME",url:url}).catch(copy);else copy();},HitMePerformance:function(fps,maxMs,target){var panel=document.getElementById('performance');if(panel){panel.textContent='Unity '+fps.toFixed(1)+' FPS · max '+maxMs.toFixed(1)+' ms · target '+target;}}});
